# URL publique du site, sans barre oblique finale (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Adresse de contact affichée publiquement (facultatif).
NEXT_PUBLIC_CONTACT_EMAIL=

# Mentions légales (page /legal).
NEXT_PUBLIC_LEGAL_PUBLISHER=
NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_LEGAL_HOST=

# Formulaire de contact : envoi via Resend (https://resend.com). Variables serveur uniquement, jamais exposées au navigateur.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Expéditeur vérifié dans Resend, ex. "Toolify <contact@exemple.fr>"
CONTACT_FROM_EMAIL=

# Affiche les emplacements publicitaires réservés (désactivé par défaut).
NEXT_PUBLIC_ADS_ENABLED=false
